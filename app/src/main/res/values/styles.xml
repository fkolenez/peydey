<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TotalsText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="TotalsDots" parent="TotalsText">
        <item name="android:text">........................................................</item>
        <item name="android:ellipsize">none</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="HistoryEntryText" parent="TotalsText">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HistoryEntryDots" parent="TotalsDots">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="HistoryDetailText" parent="TotalsText">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#8A8A87</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="HistoryDetailDots" parent="TotalsDots">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">#8A8A87</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>