<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f5f5f4"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- LOGO / MARCA — mantido igual ao original, mexa aqui se quiser trocar -->
            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_menu"
                    android:layout_width="345dp"
                    android:layout_height="140dp"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:text="PeiDay"
                    android:textColor="#4C8C5F"
                    android:textFontWeight="800"
                    android:textSize="110sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/label_text_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Quanto você ganha fazendo poha nenhuma?"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold|italic" />
            </LinearLayout>

            <!-- CAMPO USUÁRIO -->
            <TextView
                android:id="@+id/usuario"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/inter"
                android:text="Usuário"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/username"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/css"
                android:hint="Digite seu usuário"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- CAMPO SENHA -->
            <TextView
                android:id="@+id/senha"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Senha"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/password"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/css"
                android:hint="Digite sua senha"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- ESQUECEU A SENHA — alinhado à direita, como no modelo -->
            <TextView
                android:id="@+id/redefinir_senha"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/inter"
                android:gravity="end"
                android:text="Esqueceu sua senha?"
                android:textColor="#D3D3D3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- BOTÃO ENTRAR -->
            <Button
                android:id="@+id/btn_entrar"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/botao_login"
                android:fontFamily="@font/inter"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- DIVISOR "ou" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/inter"
                android:text="ou"
                android:textColor="#888888"
                android:textSize="14sp" />

            <!-- LOGIN SOCIAL -->
            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="4">

                <ImageView
                    android:id="@+id/btn_google"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/circle_social_background"
                    android:contentDescription="Entrar com Google"
                    android:padding="12dp"
                    android:src="@drawable/ic_google" />

                <ImageView
                    android:id="@+id/btn_facebook"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/circle_social_background"
                    android:contentDescription="Entrar com Facebook"
                    android:padding="12dp"
                    android:src="@drawable/ic_facebook" />

                <ImageView
                    android:id="@+id/btn_twitter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/circle_social_background"
                    android:contentDescription="Entrar com Twitter"
                    android:padding="12dp"
                    android:src="@drawable/ic_x" />

                <ImageView
                    android:id="@+id/btn_linkedin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/circle_social_background"
                    android:contentDescription="Entrar com LinkedIn"
                    android:padding="12dp"
                    android:src="@drawable/ic_linkedin" />
            </LinearLayout>

            <!-- RODAPÉ CADASTRO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Não tem uma conta? "
                    android:textColor="#000000"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/cadastrar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Cadastre-se"
                    android:textColor="#4C8C5F"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
