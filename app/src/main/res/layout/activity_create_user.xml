<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f5f5f4"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- LOGO / MARCA -->
            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_menu"
                    android:layout_width="345dp"
                    android:layout_height="140dp"
                    android:fontFamily="@font/baloo2"
                    android:gravity="center"
                    android:text="PeiDay"
                    android:textColor="#4C8C5F"
                    android:textFontWeight="800"
                    android:textSize="110sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/label_text_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Crie sua conta e comece a controlar seus ganhos."
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold|italic" />
            </LinearLayout>

            <!-- Campo nome completo -->
            <TextView
                android:id="@+id/create_user_name"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter"
                android:text="Nome completo"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/nome_completo"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_input"
                android:hint="Digite seu nome completo"
                android:inputType="textPersonName|textCapWords"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- Campo e-mail -->
            <TextView
                android:id="@+id/email"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="E-mail"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/create_user_email"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_input"
                android:hint="Digite seu e-mail"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- Campo senha -->
            <TextView
                android:id="@+id/senha"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Senha"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/create_user_password"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_input"
                android:hint="Crie uma senha"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- Campo confirmar senha -->
            <TextView
                android:id="@+id/confirmar_senha"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Confirmar senha"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/create_user_password_confirm"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_login_input"
                android:hint="Repita sua senha"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- Botão "Cadastrar" -->
            <Button
                android:id="@+id/btn_sing_up"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_btn_login"
                android:fontFamily="@font/inter"
                android:text="Cadastrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Divisor "ou" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/inter"
                android:text="ou"
                android:textColor="#888888"
                android:textSize="14sp" />

            <!-- Rodape login -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Já tem uma conta? "
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/label_redirect_to_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Entrar"
                    android:textColor="#4C8C5F"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>