<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HistoryActivity">

    <!-- Navbar fixa no rodapé -->
    <include
        android:id="@+id/navbar"
        layout="@layout/navbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#f5f5f4"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navbar">

        <include layout="@layout/hero_banner" />

        <!-- Faixa verde com o título da tela -->
        <TextView
            android:id="@+id/label_history_title"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Historico"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Card com rolagem -->
        <LinearLayout
            android:id="@+id/history_card"
            android:layout_width="350dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_totals_card"
            android:orientation="vertical"
            android:padding="8dp">

            <ScrollView
                android:id="@+id/history_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fadeScrollbars="false"
                android:scrollbarSize="12dp"
                android:scrollbarStyle="insideInset"
                android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
                android:scrollbarTrackVertical="@drawable/scrollbar_track"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/history_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- ===== HOJE ===== -->
                    <TextView
                        style="@style/HistoryEntryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOJE" />

                    <!-- Cafés tomados -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAFÉS TOMADOS" />
                        <TextView style="@style/HistoryEntryDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5x" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dinheiro ganho" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$:12,50" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tempo gasto" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42m 32s" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cafeina estimada" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~475mg" />
                    </LinearLayout>

                    <!-- Cagadas remuneradas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAGADAS REMUNERADAS" />
                        <TextView style="@style/HistoryEntryDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2X" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dinheiro ganho" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$:12,50" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tempo gasto" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42m 32s" />
                    </LinearLayout>

                    <!-- Conversas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONVERSAS" />
                        <TextView style="@style/HistoryEntryDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5x" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dinheiro ganho" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$:12,50" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tempo gasto" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42m 32s" />
                    </LinearLayout>

                    <!-- Divisor pontilhado (reaproveitado) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_dashed_line"
                        android:layerType="software" />

                    <!-- ===== 17 de Agosto, 2026 ===== -->
                    <TextView
                        style="@style/HistoryEntryText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="17 de Agosto, 2026" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CAFÉS TOMADOS" />
                        <TextView style="@style/HistoryEntryDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryEntryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2x" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dinheiro ganho" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R$:12,50" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tempo gasto" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="42m 32s" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cafeina estimada" />
                        <TextView style="@style/HistoryDetailDots" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                        <TextView style="@style/HistoryDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="~475mg" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>