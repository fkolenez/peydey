<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomePageActivity">

    <!-- Navbar fixa no rodapé -->
    <include
        android:id="@+id/navbar"
        layout="@layout/navbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#f5f5f4"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/navbar">

        <include layout="@layout/hero_banner" />

        <LinearLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="30dp"
            android:radius="100dp"
            android:background="@drawable/bg_profile_card"
            android:gravity="center">

            <ImageView
                android:id="@+id/img_profile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Foto de perfil"
                android:src="@drawable/ic_person" />
        </LinearLayout>


        <TextView
            android:id="@+id/label_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Flávio Kolenez"
            android:textColor="#000000"
            android:textFontWeight="900"
            android:textStyle="bold"
            android:textSize="24dp"
            />

        <LinearLayout
            android:id="@+id/achievements_bagdes"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:radius="24dp"
            >

            <TextView
                android:id="@+id/label_achievements"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conquistas"
                android:textColor="#000000"
                android:textFontWeight="900"
                android:textStyle="bold"
                android:textSize="20dp"
                />

            <LinearLayout
                android:id="@+id/badges_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/badge_regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_bagde_brown"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Regular"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_coffe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_profile_bagde_green"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Cafezinho"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profile_history"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_totals_card"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="22dp">

            <TextView
                style="@style/TotalsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAIS GERAIS" />

            <!-- Cagadas remuneradas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAGADAS REMUNERADAS" />

                <TextView
                    style="@style/TotalsDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/value_paid_breaks"
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50X" />
            </LinearLayout>

            <!-- Conversas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONVERSAS" />

                <TextView
                    style="@style/TotalsDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/value_conversations"
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50X" />
            </LinearLayout>

            <!-- Cafés tomados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAFÉS TOMADOS" />

                <TextView
                    style="@style/TotalsDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/value_coffees"
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32X" />
            </LinearLayout>

            <!-- Cafeína estimada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAFEINA ESTIMADA" />

                <TextView
                    style="@style/TotalsDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/value_caffeine"
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~450mg" />
            </LinearLayout>

            <!-- Divisor pontilhado -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_dashed_line"
                android:layerType="software" />

            <!-- Dinheiro total ganho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DINHEIRO TOTAL GANHO" />

                <TextView
                    style="@style/TotalsDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/value_money"
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$20,00" />
            </LinearLayout>

            <!-- Tempo gasto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TEMPO GASTO" />

                <TextView
                    style="@style/TotalsDots"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/value_time"
                    style="@style/TotalsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2H 32m 2s" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>