<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#f5f5f4"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- INÍCIO (ativo) -->
    <LinearLayout
        android:id="@+id/nav_inicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_nav_item_selected"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ic_nav_inicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="Início"
                app:tint="#1A1A1A" />

            <TextView
                android:id="@+id/label_nav_inicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Início"
                android:textColor="#1A1A1A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- HISTÓRICO -->
    <LinearLayout
        android:id="@+id/nav_historico"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ic_nav_historico"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_history"
            android:contentDescription="Histórico"
            app:tint="#8A8A80" />

        <TextView
            android:id="@+id/label_nav_historico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Historico"
            android:textColor="#8A8A80"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- RANKING -->
    <LinearLayout
        android:id="@+id/nav_ranking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ic_nav_ranking"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_ranking"
            android:contentDescription="Ranking"
            app:tint="#8A8A80" />

        <TextView
            android:id="@+id/label_nav_ranking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ranking"
            android:textColor="#8A8A80"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- CONQUISTAS -->
    <LinearLayout
        android:id="@+id/nav_conquistas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ic_nav_conquistas"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nav_trophy"
            android:contentDescription="Conquistas"
            app:tint="#8A8A80" />

        <TextView
            android:id="@+id/label_nav_conquistas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Conquistas"
            android:textColor="#8A8A80"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>