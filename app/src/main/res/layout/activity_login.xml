<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#f5f5f4"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- LOGO / MARCA -->
            <LinearLayout
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="PeyDey"
                    android:textColor="#4C8C5F"
                    android:textFontWeight="800"
                    android:textSize="72sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/label_text_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quanto você ganha fazendo poha nenhuma?"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold|italic" />
            </LinearLayout>

            <!-- Campo usuario -->
            <TextView
                android:id="@+id/usuario"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Usuário"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/login_user"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_input"
                android:hint="Digite seu usuário"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- Campo senha -->
            <TextView
                android:id="@+id/senha"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:text="Senha"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/login_password"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_login_input"
                android:hint="Digite sua senha"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#000000" />

            <!-- Esqueceu a senha -->
            <TextView
                android:id="@+id/login_reset_password"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="end"
                android:text="Esqueceu sua senha?"
                android:textColor="#D3D3D3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Botão "Entrar" -->
            <Button
                android:id="@+id/btn_login"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:layout_marginBottom="48dp"
                android:background="@drawable/bg_btn_login"
                app:backgroundTint="@null"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Divisor "ou" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="ou"
                android:textColor="#888888"
                android:textSize="14sp" />

            <!-- Login social -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Não tem uma conta? "
                    android:textColor="#000000"
                    android:textSize="13sp" />

                    <TextView
                        android:id="@+id/label_redirect_to_create_user"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cadastre-se"
                        android:textColor="#4C8C5F"
                        android:textSize="13sp"
                        android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>